# System (non-Python) requirements for the skills. Install with: brew bundle
# (run in the repo root; Homebrew reads this file).

# tensor-calculus: pdftoppm renders compiled LaTeX PDFs to PNG
brew "poppler"
# tensor-calculus: fetches the Hitchhiker's Guide to Abaqus from GitHub
brew "git"

# tensor-calculus: compiles derivations with real LaTeX (provides latexmk and pdflatex).
# Large download (~5 GB); skip it if you already have a LaTeX installation with latexmk.
cask "mactex-no-gui"
